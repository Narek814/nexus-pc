        }
      }
    },
    "limit.files.bodyWithLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free plan allows {LIMIT}. Pro removes the limit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатном тарифе доступно {LIMIT}. В Pro лимита нет."
          }
        }
      }
    },
    "pro.card.ownerHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro is checked for the account this PC is linked to."

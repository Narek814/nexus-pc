    "monitor.chart.emptyLong": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Per-minute averages appear after the PC service has run for a minute."}}, "ru": {"stringUnit": {"state": "translated", "value": "Средние значения за минуту появятся через минуту работы службы."}}}},

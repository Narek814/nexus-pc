      }
    },
    "error.input.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PC isn't accepting input: the screen is locked, a security prompt is open, or control is turned off in the N icon menu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

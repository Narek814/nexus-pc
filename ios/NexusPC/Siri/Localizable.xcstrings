            "state": "translated",
            "value": "The PC screen is locked, a security prompt is open, or screen sharing is turned off in the N icon menu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран ПК заблокирован, открыт запрос безопасности или показ экрана запрещён в меню значка N."
          }

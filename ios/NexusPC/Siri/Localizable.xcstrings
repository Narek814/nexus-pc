          "stringUnit": {
            "state": "translated",
            "value": "Screen sharing was declined on the PC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показ экрана отклонён на ПК."
          }
        }
      }
    },
    "error.screen.blocked": {
      "extractionState": "manual",
      "localizations": {

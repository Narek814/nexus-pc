    "pc.forget.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget This PC?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть этот ПК?"
          }
        }
      }
    },
    "pc.forget.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's removed only from this iPhone. To remove this iPhone on the PC: N icon → Devices and Permissions. To reconnect, scan the QR code again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПК удаляется только с этого iPhone. Чтобы удалить iPhone на ПК: значок N → «Устройства и разрешения». Подключиться снова можно по QR-коду."
          }
        }
      }
    },
    "pc.forget.confirm.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget PC"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть ПК"
          }
        }
      }

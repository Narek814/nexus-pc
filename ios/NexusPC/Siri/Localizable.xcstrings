    "error.screen.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen sharing was declined on the PC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показ экрана отклонён на ПК."
          }
        }
      }
    },
    "error.screen.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PC screen is locked, a security prompt is open, or screen sharing is turned off in the N icon menu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран ПК заблокирован, открыт запрос безопасности или показ экрана запрещён в меню значка N."
          }
        }
      }
    },
    "error.input.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PC isn't accepting input: the screen is locked, a security prompt is open, or control is turned off in the N icon menu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПК не принимает ввод: экран заблокирован, открыт запрос безопасности или управление запрещено в меню значка N."
          }
        }
      }
    },
    "error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. Wait a moment and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов. Подождите немного и повторите."

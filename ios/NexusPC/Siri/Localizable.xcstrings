    "rgb.appliedPartial %lld %lld %@ %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Applied on %1$lld of %2$lld. Failed: %3$@. %4$@"}}, "ru": {"stringUnit": {"state": "translated", "value": "Применено на %1$lld из %2$lld. Не удалось: %3$@. %4$@"}}}},
    "files.section.clipboard": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Clipboard"}}, "ru": {"stringUnit": {"state": "translated", "value": "Буфер обмена"}}}},
    "files.section.folder": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Nexus PC Folder on PC"}}, "ru": {"stringUnit": {"state": "translated", "value": "Папка Nexus PC на ПК"}}}},
    "files.pick.photos": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Photos and Videos"}}, "ru": {"stringUnit": {"state": "translated", "value": "Фото и видео"}}}},

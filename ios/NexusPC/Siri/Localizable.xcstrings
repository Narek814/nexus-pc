    "rgb.section.look": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Color and Effect"}}, "ru": {"stringUnit": {"state": "translated", "value": "Цвет и эффект"}}}},
    "rgb.section.profiles": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Lighting Profiles"}}, "ru": {"stringUnit": {"state": "translated", "value": "Профили подсветки"}}}},
    "rgb.section.devices": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Devices"}}, "ru": {"stringUnit": {"state": "translated", "value": "Устройства"}}}},
    "rgb.unavailable.help": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "OpenRGB comes with Nexus PC and starts with the PC. If lighting doesn't respond, close Armoury Crate (it takes over lighting) and restart the PC. Devices are set up on the PC: N icon → Set Up Lighting (OpenRGB)…"}}, "ru": {"stringUnit": {"state": "translated", "value": "OpenRGB входит в Nexus PC и запускается вместе с ПК. Если подсветка не отвечает: закройте Armoury Crate (он перехватывает подсветку) и перезагрузите ПК. Устройства настраиваются на ПК: значок «N» → «Настроить подсветку (OpenRGB)…»."}}}},
    "rgb.color": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Color"}}, "ru": {"stringUnit": {"state": "translated", "value": "Цвет"}}}},
    "rgb.brightness %lld": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Brightness: %lld%%"}}, "ru": {"stringUnit": {"state": "translated", "value": "Яркость: %lld%%"}}}},
    "rgb.effect": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Effect"}}, "ru": {"stringUnit": {"state": "translated", "value": "Эффект"}}}},
    "rgb.effect.static": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Solid Color"}}, "ru": {"stringUnit": {"state": "translated", "value": "Ровный цвет"}}}},
    "rgb.effect.off": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Off"}}, "ru": {"stringUnit": {"state": "translated", "value": "Выключить"}}}},
    "rgb.effect.static.short": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "solid color"}}, "ru": {"stringUnit": {"state": "translated", "value": "ровный цвет"}}}},
    "rgb.effect.off.short": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "off"}}, "ru": {"stringUnit": {"state": "translated", "value": "выключено"}}}},
    "rgb.effect.help": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Brightness applies to the solid color. Device effects (Breathing, Rainbow…) work only on devices that have them."}}, "ru": {"stringUnit": {"state": "translated", "value": "Яркость применяется к ровному цвету. Эффекты устройств (Breathing, Rainbow…) работают только на тех устройствах, где они есть."}}}},
    "rgb.apply": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apply"}}, "ru": {"stringUnit": {"state": "translated", "value": "Применить"}}}},
    "rgb.saveAsProfile": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Save as Profile"}}, "ru": {"stringUnit": {"state": "translated", "value": "Сохранить как профиль"}}}},
    "rgb.profiles.empty": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "No profiles yet. Set up a color and tap Save as Profile."}}, "ru": {"stringUnit": {"state": "translated", "value": "Профилей пока нет. Настройте цвет и нажмите «Сохранить как профиль»."}}}},
    "rgb.profile.apply": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Apply Profile"}}, "ru": {"stringUnit": {"state": "translated", "value": "Применить профиль"}}}},
    "rgb.profile.loadToEditor": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Load into Settings"}}, "ru": {"stringUnit": {"state": "translated", "value": "Загрузить в настройки"}}}},
    "rgb.profile.delete": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Delete"}}, "ru": {"stringUnit": {"state": "translated", "value": "Удалить"}}}},
    "rgb.profiles.hint": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Touch and hold a profile to change or delete it. A profile linked to an app profile turns on together with it."}}, "ru": {"stringUnit": {"state": "translated", "value": "Удерживайте профиль, чтобы изменить или удалить. Профиль, связанный с профилем программ, включается вместе с ним."}}}},
    "rgb.leds %lld": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "%lld LED"}}, "ru": {"stringUnit": {"state": "translated", "value": "%lld LED"}}}},
    "rgb.skydimo": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "OpenRGB doesn't support Skydimo monitor lighting: it stays in the Skydimo app."}}, "ru": {"stringUnit": {"state": "translated", "value": "Подсветку монитора Skydimo OpenRGB не поддерживает — она остаётся в приложении Skydimo."}}}},
    "rgb.save.linkTo": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "App Profile"}}, "ru": {"stringUnit": {"state": "translated", "value": "Профиль программ"}}}},
    "rgb.save.noLink": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Don't Link"}}, "ru": {"stringUnit": {"state": "translated", "value": "Не связывать"}}}},
    "rgb.save.linkFooter": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The linked lighting profile turns on when you run this app profile (from iPhone, Siri or a widget)."}}, "ru": {"stringUnit": {"state": "translated", "value": "Связанный профиль подсветки включится, когда вы запустите этот профиль программ (с iPhone, через Siri или виджет)."}}}},
    "rgb.save.name": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Name"}}, "ru": {"stringUnit": {"state": "translated", "value": "Название"}}}},
    "rgb.save.namePlaceholder": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "For example, Evening"}}, "ru": {"stringUnit": {"state": "translated", "value": "Например, Вечер"}}}},
    "rgb.save.title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Lighting Profile"}}, "ru": {"stringUnit": {"state": "translated", "value": "Профиль подсветки"}}}},
    "rgb.linkedWith %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "with “%@”"}}, "ru": {"stringUnit": {"state": "translated", "value": "вместе с «%@»"}}}},

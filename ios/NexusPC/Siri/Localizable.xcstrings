    "files.send.hint": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Files go to Downloads\\Nexus PC on the PC. iPhone photos are sent as JPEG, videos as MP4. If the connection drops, sending the same file again resumes where it stopped. Keep the app open until the transfer ends."}}, "ru": {"stringUnit": {"state": "translated", "value": "Файлы попадут в «Загрузки\\Nexus PC» на ПК. Фото iPhone отправляются как JPEG, видео — как MP4. Если связь оборвётся, повторная отправка того же файла продолжится с места обрыва. Держите приложение открытым до конца передачи."}}}},
    "clipboard.send.hint": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Pastes text from the iPhone clipboard into the PC clipboard; then press Ctrl+V on the PC."}}, "ru": {"stringUnit": {"state": "translated", "value": "Вставляет текст из буфера iPhone в буфер ПК — дальше Ctrl+V на ПК."}}}},
    "clipboard.copied": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Copied to the iPhone clipboard."}}, "ru": {"stringUnit": {"state": "translated", "value": "Скопировано в буфер iPhone."}}}},
    "clipboard.note": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Only when you tap: there is no automatic sync. The PC shows a notification when the phone reads or changes its clipboard."}}, "ru": {"stringUnit": {"state": "translated", "value": "Только по нажатию: автоматической синхронизации нет. ПК показывает уведомление, когда телефон читает или меняет его буфер."}}}},
    "clipboard.sent": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The text is in the PC clipboard: press Ctrl+V."}}, "ru": {"stringUnit": {"state": "translated", "value": "Текст в буфере ПК — нажмите Ctrl+V."}}}},
    "clipboard.sent.truncated": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Sent to the PC (first 100,000 characters)."}}, "ru": {"stringUnit": {"state": "translated", "value": "Отправлено на ПК (первые 100 000 символов)."}}}},
    "clipboard.empty": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The PC clipboard has no text (it may hold a picture or files)."}}, "ru": {"stringUnit": {"state": "translated", "value": "В буфере ПК нет текста (может быть картинка или файлы)."}}}},
    "files.freeSpace %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Free on the PC disk: %@"}}, "ru": {"stringUnit": {"state": "translated", "value": "Свободно на диске ПК: %@"}}}},
    "files.error.photo %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't read the photo: %@"}}, "ru": {"stringUnit": {"state": "translated", "value": "Не удалось прочитать фото: %@"}}}},
    "files.error.open %@": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't open “%@”."}}, "ru": {"stringUnit": {"state": "translated", "value": "Не удалось открыть «%@»."}}}},

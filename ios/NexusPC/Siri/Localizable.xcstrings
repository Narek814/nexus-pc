      }
    },
    "pro.revoked.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro is no longer active for the owner of this PC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro больше не действует для владельца этого ПК."
          }
        }
      }
    },
    "limit.files.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached the free limit for file transfer. Pro removes it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы достигли бесплатного лимита передачи файлов. В Pro его нет."

    "error.pair.deviceLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many devices are connected to this PC. Remove one on the PC: N icon → Devices and Permissions."
          }

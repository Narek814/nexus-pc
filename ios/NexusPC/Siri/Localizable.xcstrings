{
  "sourceLanguage": "en",
  "strings": {
    "pro.feature.profiles.body": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Open several apps with one tap."}}, "ru": {"stringUnit": {"state": "translated", "value": "Запуск нескольких программ одним касанием."}}}},
    "pro.feature.rgb.sync.body": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Control lighting from iPhone."}}, "ru": {"stringUnit": {"state": "translated", "value": "Управление подсветкой с iPhone."}}}},
    "pro.feature.automations.body": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Let the PC do things on schedule."}}, "ru": {"stringUnit": {"state": "translated", "value": "ПК сам выполняет действия по расписанию."}}}},
    "pro.feature.monitoring.extended.body": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "See up to 24 hours of history."}}, "ru": {"stringUnit": {"state": "translated", "value": "История показателей за сутки."}}}},
    "pro.feature.screen.video.body": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Smooth video of the PC screen."}}, "ru": {"stringUnit": {"state": "translated", "value": "Плавное видео экрана ПК."}}}},
    "pro.feature.files.body": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Transfer files without limits."}}, "ru": {"stringUnit": {"state": "translated", "value": "Передача файлов без ограничений."}}}},
    "automations.paused.title": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Automations Paused"}}, "ru": {"stringUnit": {"state": "translated", "value": "Автоматизации остановлены"}}}},
    "automations.paused.body": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "They're stopped, not deleted. Renew Pro to run them again."}}, "ru": {"stringUnit": {"state": "translated", "value": "Они остановлены, а не удалены. Продлите Pro, чтобы они снова работали."}}}},
    "monitor.historyReset": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "History starts again after the PC restarts."}}, "ru": {"stringUnit": {"state": "translated", "value": "После перезапуска ПК история начинается заново."}}}},
    "rgb.empty.body": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "OpenRGB is running but found no devices."}}, "ru": {"stringUnit": {"state": "translated", "value": "OpenRGB запущен, но не нашёл устройств."}}}},
    "monitor.range.10m": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "10 min"}}, "ru": {"stringUnit": {"state": "translated", "value": "10 мин"}}}},
    "monitor.range.1h": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "1 h"}}, "ru": {"stringUnit": {"state": "translated", "value": "1 ч"}}}},
    "monitor.range.24h": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "24 h"}}, "ru": {"stringUnit": {"state": "translated", "value": "24 ч"}}}},
    "monitor.unavailable": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Not available"}}, "ru": {"stringUnit": {"state": "translated", "value": "Недоступно"}}}},
    "files.send": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Send to PC"}}, "ru": {"stringUnit": {"state": "translated", "value": "Отправить на ПК"}}}},
    "files.download": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Save to iPhone"}}, "ru": {"stringUnit": {"state": "translated", "value": "Сохранить на iPhone"}}}},
    "files.empty.body": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Files in the Downloads\\Nexus PC folder on the PC appear here."}}, "ru": {"stringUnit": {"state": "translated", "value": "Здесь появляются файлы из папки «Загрузки\\Nexus PC» на ПК."}}}},
    "clipboard.get": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Paste from PC Clipboard"}}, "ru": {"stringUnit": {"state": "translated", "value": "Из буфера обмена ПК"}}}},
    "monitor.reason.sensorDriverMissing": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Needs the sensor driver. Reinstall Nexus PC on the PC."}}, "ru": {"stringUnit": {"state": "translated", "value": "Нужен драйвер датчиков. Переустановите Nexus PC на ПК."}}}},
    "monitor.reason.sensorReadFailed": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't read the sensors. Restart the PC."}}, "ru": {"stringUnit": {"state": "translated", "value": "Не удалось прочитать датчики. Перезагрузите ПК."}}}},
    "monitor.reason.sensorMissing": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "This processor doesn't report this value."}}, "ru": {"stringUnit": {"state": "translated", "value": "Процессор не сообщает это значение."}}}},
    "monitor.reason.warmingUp": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Measuring…"}}, "ru": {"stringUnit": {"state": "translated", "value": "Измеряем…"}}}},
    "monitor.reason.osQueryFailed": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Windows didn't respond. Try again in a moment."}}, "ru": {"stringUnit": {"state": "translated", "value": "Windows не ответила. Подождите немного."}}}},
    "monitor.reason.gpuDriverMissing": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Available only for NVIDIA graphics with the driver installed."}}, "ru": {"stringUnit": {"state": "translated", "value": "Доступно только для видеокарт NVIDIA с установленным драйвером."}}}},
    "monitor.reason.gpuLibraryRejected": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The graphics driver files look wrong. Reinstall the NVIDIA driver."}}, "ru": {"stringUnit": {"state": "translated", "value": "Файлы драйвера видеокарты повреждены. Переустановите драйвер NVIDIA."}}}},
    "monitor.reason.gpuLibraryLoadFailed": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't start the graphics driver. Update the NVIDIA driver."}}, "ru": {"stringUnit": {"state": "translated", "value": "Не удалось запустить драйвер видеокарты. Обновите драйвер NVIDIA."}}}},
    "monitor.reason.gpuInitFailed": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Couldn't start the graphics driver. Update the NVIDIA driver."}}, "ru": {"stringUnit": {"state": "translated", "value": "Не удалось запустить драйвер видеокарты. Обновите драйвер NVIDIA."}}}},
    "monitor.reason.gpuListFailed": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The graphics card didn't respond. Restart the PC."}}, "ru": {"stringUnit": {"state": "translated", "value": "Видеокарта не ответила. Перезагрузите ПК."}}}},
    "monitor.reason.platformUnsupported": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Not available on this PC."}}, "ru": {"stringUnit": {"state": "translated", "value": "Недоступно на этом ПК."}}}},
    "monitor.reason.unknown": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Not available right now."}}, "ru": {"stringUnit": {"state": "translated", "value": "Сейчас недоступно."}}}},

            "state": "translated",
            "value": "Войдите в Windows на ПК и проверьте, что Nexus PC запущен у часов."
          }
        }
      }
    },
    "error.power.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PC couldn't do this. It may be blocked by another program. Try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПК не смог это выполнить. Возможно, мешает другая программа. Повторите."
          }
        }
      }
    },
    "error.power.nothingToCancel": {
      "extractionState": "manual",
      "localizations": {

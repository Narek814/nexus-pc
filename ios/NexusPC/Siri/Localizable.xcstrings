    "error.pair.noActiveSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PC isn't waiting for a connection. On the PC, click the N icon → Connect iPhone, then scan the new QR code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПК сейчас не ждёт подключения. На ПК нажмите значок N → «Подключить iPhone» и отсканируйте новый QR-код."
          }
        }
      }
    },
    "error.pair.invalidCode": {
      "extractionState": "manual",
      "localizations": {

      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong on the PC. Try again. If it repeats, restart the PC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На ПК произошла ошибка. Повторите. Если повторяется — перезагрузите ПК."
          }
        }
      }
    },
    "error.generic.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If it repeats, see Help → Diagnostics."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите. Если не помогает — откройте «Помощь → Диагностика»."
          }
        }
      }
    },
    "pc.forget.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget This PC?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть этот ПК?"
          }
        }
      }
    },
    "pc.forget.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pairing is removed only on this iPhone. On the PC, this device stays in Devices and Permissions until you remove it there."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сопряжение удаляется только на этом iPhone. На ПК устройство останется в «Устройства и разрешения», пока вы не удалите его там."
          }
        }
      }
    },
    "pc.forget.confirm.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget PC"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть ПК"
          }
        }
      }

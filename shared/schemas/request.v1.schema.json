{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexuspc:protocol/request/v1",
  "title": "Nexus PC request envelope v1",
  "description": "Request sent by a client (iPhone) to Nexus.Agent. Source of truth for Nexus.Core (C#) and NexusKit (Swift). Must stay in sync with windows/Nexus.Core/Protocol/CommandCatalog.cs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "kind",
    "type",
    "ts",
    "payload"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "kind": {
      "const": "request"
    },
    "type": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "pcId": {
      "$ref": "#/$defs/uuid"
    },
    "confirmed": {
      "type": "boolean",
      "description": "User confirmed a critical action on the client. UX safeguard, not a security boundary (SECURITY.md §3.12)."
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "system.hello",
              "pc.status",
              "power.lock",
              "power.sleep",
              "power.cancel",
              "apps.list",
              "profiles.list",
              "metrics.snapshot",
              "alerts.get",
              "alerts.test",
              "rgb.status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/empty"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "power.shutdown",
              "power.restart"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/powerPayload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "apps.launch",
              "apps.close"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/appRef"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "profiles.run",
              "profiles.delete",
              "rgb.profiles.delete",
              "rgb.profiles.apply"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/profileRef"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "profiles.upsert"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/profileUpsert"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "pair.request"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/pairRequest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "auth.begin"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/authBegin"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "auth.prove"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/authProve"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "metrics.history"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/metricsHistory"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "alerts.set"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/alertsSet"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rgb.apply"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/rgbLook"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rgb.profiles.upsert"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/rgbProfileUpsert"
          }
        }
      }
    },
    {
      "properties": {
        "type": {
          "enum": [
            "system.hello",
            "auth.prove",
            "auth.begin",
            "pair.request",
            "pc.status",
            "power.shutdown",
            "power.restart",
            "power.sleep",
            "power.lock",
            "power.cancel",
            "apps.list",
            "apps.launch",
            "apps.close",
            "profiles.list",
            "profiles.run",
            "profiles.upsert",
            "profiles.delete",
            "metrics.snapshot",
            "metrics.history",
            "alerts.get",
            "alerts.set",
            "alerts.test",
            "rgb.status",
            "rgb.apply",
            "rgb.profiles.upsert",
            "rgb.profiles.delete",
            "rgb.profiles.apply"
          ]
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "empty": {
      "type": "object",
      "additionalProperties": false
    },
    "powerPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delaySeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "force": {
          "type": "boolean"
        }
      }
    },
    "appRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appId"
      ],
      "properties": {
        "appId": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId"
      ],
      "properties": {
        "profileId": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "profileUpsert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "appIds"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "name": {
              "$ref": "#/$defs/displayName"
            },
            "appIds": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/slug"
              }
            }
          }
        }
      }
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?=.*\\S)[^\\x00-\\x1f\\x7f]+$"
    },
    "base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "pairRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "deviceName",
        "publicKey"
      ],
      "description": "publicKey: base64 DER SubjectPublicKeyInfo of a P-256 key (curve is checked by implementations, not by this schema).",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        },
        "deviceName": {
          "$ref": "#/$defs/displayName"
        },
        "publicKey": {
          "allOf": [
            {
              "$ref": "#/$defs/base64"
            },
            {
              "maxLength": 268
            }
          ]
        }
      }
    },
    "authBegin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId"
      ],
      "properties": {
        "deviceId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "authProve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signature"
      ],
      "description": "signature: base64 DER (X9.62) ECDSA P-256 SHA-256 over the auth transcript (docs/API.md).",
      "properties": {
        "signature": {
          "allOf": [
            {
              "$ref": "#/$defs/base64"
            },
            {
              "maxLength": 172
            }
          ]
        }
      }
    },
    "metricsHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range"
      ],
      "properties": {
        "range": {
          "enum": [
            "10m",
            "1h",
            "24h"
          ]
        }
      }
    },
    "alertsSet": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Any subset. Ranges are checked by the agent (gpuTemperatureC 50..110, *Percent 50..100, diskFreePercent 1..50, cooldownMinutes 5..1440).",
      "properties": {
        "gpuTemperatureEnabled": {
          "type": "boolean"
        },
        "gpuTemperatureC": {
          "type": "integer"
        },
        "cpuUsageEnabled": {
          "type": "boolean"
        },
        "cpuUsagePercent": {
          "type": "integer"
        },
        "memoryUsageEnabled": {
          "type": "boolean"
        },
        "memoryUsagePercent": {
          "type": "integer"
        },
        "diskFreeEnabled": {
          "type": "boolean"
        },
        "diskFreePercent": {
          "type": "integer"
        },
        "powerEventsEnabled": {
          "type": "boolean"
        },
        "cooldownMinutes": {
          "type": "integer"
        },
        "ntfyEnabled": {
          "type": "boolean"
        },
        "ntfyServer": {
          "type": "string",
          "pattern": "^https://[^/?#\\s]+/?$",
          "maxLength": 200
        },
        "regenerateTopic": {
          "type": "boolean"
        }
      }
    },
    "rgbLook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "brightness",
        "effect"
      ],
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "brightness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "\"static\", \"off\" or the name of a device's own mode (e.g. \"Rainbow\")."
        },
        "devices": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        }
      }
    },
    "rgbProfileUpsert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "color",
            "brightness",
            "effect"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "name": {
              "$ref": "#/$defs/displayName"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "brightness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "effect": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "\"static\", \"off\" or the name of a device's own mode (e.g. \"Rainbow\")."
            }
          }
        }
      }
    }
  }
}

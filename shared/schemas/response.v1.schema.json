{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexuspc:protocol/response/v1",
  "title": "Nexus PC response envelope v1",
  "description": "Response from Nexus.Agent to a request. `id` echoes the request id, or is null when the request could not be parsed. Plan fields (`plan`, `features`, `entitlementState`, `validUntil`) are additive and optional: they appear only in `system.hello` after auth.prove and in `account.refresh` (docs/API.md, «Планы»). Account identifiers and email never appear in responses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "kind", "ok"],
  "properties": {
    "v": { "const": 1 },
    "id": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }] },
    "kind": { "const": "response" },
    "ok": { "type": "boolean" },
    "payload": { "$ref": "#/$defs/payload" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z]+\\.[A-Za-z]+$|^internal$" },
        "message": { "type": "string" },
        "details": { "$ref": "#/$defs/errorDetails" }
      }
    }
  },
  "if": { "properties": { "ok": { "const": true } } },
  "then": { "required": ["payload"], "not": { "required": ["error"] } },
  "else": { "required": ["error"], "not": { "required": ["payload"] } },
  "$defs": {
    "featureId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*){0,3}$"
    },
    "entitlementState": { "enum": ["none", "active", "grace", "expired", "revoked"] },
    "payload": {
      "type": "object",
      "properties": {
        "plan": { "enum": ["free", "pro"] },
        "features": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/featureId" } },
        "entitlementState": { "$ref": "#/$defs/entitlementState" },
        "validUntil": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "email": false,
        "accountId": false,
        "sub": false
      },
      "dependentRequired": {
        "plan": ["features", "entitlementState"],
        "features": ["plan", "entitlementState"],
        "entitlementState": ["plan", "features"],
        "validUntil": ["plan", "features", "entitlementState"]
      },
      "if": { "required": ["authenticated"], "properties": { "authenticated": { "const": false } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["plan"] },
            { "required": ["features"] },
            { "required": ["entitlementState"] },
            { "required": ["validUntil"] }
          ]
        }
      }
    },
    "errorDetails": {
      "description": "Optional machine-readable details. plan.required: { feature, state? }; plan.limit: { feature, limit }; rate.limited: { retryAfter } (seconds, e.g. for account.refresh).",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "feature": { "$ref": "#/$defs/featureId" },
        "state": { "$ref": "#/$defs/entitlementState" },
        "limit": { "type": "integer", "minimum": 0 },
        "retryAfter": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    }
  }
}

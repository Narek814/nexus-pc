<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs in the signed-in person's session: desktop actions, pairing UI with QR, app list editor. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build (not run) on Linux, e.g. in the cloud session and ubuntu CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Nexus.Tray</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.0</Version>
    <!-- Invariant globalization stays; this only lets TrayText name the "ru" resources (Strings.ru.resx). -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj" />
    <ProjectReference Include="..\Nexus.Windows\Nexus.Windows.csproj" />
  </ItemGroup>
</Project>

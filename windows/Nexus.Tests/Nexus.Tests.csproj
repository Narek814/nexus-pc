<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit test method naming and fixtures-style tests trip a few recommended analyzers. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1861</NoWarn>
    <!-- Our own entry point (TestHelperProgram): a helper mode for the cross-session lock test run as SYSTEM. -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj" />
    <ProjectReference Include="..\Nexus.Agent\Nexus.Agent.csproj" />
    <ProjectReference Include="..\Nexus.DevClient\Nexus.DevClient.csproj" />
    <ProjectReference Include="..\Nexus.RGB\Nexus.RGB.csproj" />
    <ProjectReference Include="..\Nexus.Setup\Nexus.Setup.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\shared\protocol\fixtures\**\*.json" Link="shared\fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\shared\schemas\*.json" Link="shared\schemas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Targets plain net10.0 so the network/session layer runs (and is tested) on any OS.
    Windows-only parts are marked [SupportedOSPlatform("windows")] and guarded at runtime;
    the CA1416 analyzer enforces the guards. Production is Windows only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Nexus.Agent</RootNamespace>
    <AssemblyName>Nexus.Agent</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <!--
    Development/CI file key (E4-3a/E4-3b, owner decision): compiled only when the build host is not Windows AND the
    RuntimeIdentifier is not win-* (macOS CI, Linux tests). No Windows build has the code: neither the installer
    (-r win-x64) nor Debug or RID-less builds made on Windows. A build that has it still refuses it on Windows at
    run time, and it is used only with NEXUS_DEV_FILE_KEY set. Nexus.Tests.csproj uses the same condition.
  -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows')) And !$(RuntimeIdentifier.StartsWith('win'))">
    <DefineConstants>$(DefineConstants);NEXUS_DEV_FILE_KEY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj" />
    <ProjectReference Include="..\Nexus.Windows\Nexus.Windows.csproj" />
    <ProjectReference Include="..\Nexus.Monitoring\Nexus.Monitoring.csproj" />
    <ProjectReference Include="..\Nexus.RGB\Nexus.RGB.csproj" />
    <InternalsVisibleTo Include="Nexus.Tests" />
  </ItemGroup>
</Project>
